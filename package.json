{
  "name": "chinese_chess_electron",
  "version": "1.0.0",
  "description": "中国象棋桌面应用——Flutter 版 ChineseChessUltra 的 Electron 全栈重写",
  "private": true,
  "author": {
    "name": "juejian",
    "email": "2301879213@qq.com"
  },
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "npm run typecheck && eslint .",
    "test": "node tools/run-vitest.mjs run",
    "eval": "node tools/eval.mjs",
    "dist": "electron-vite build && electron-builder --linux",
    "dist:dir": "electron-vite build && electron-builder --linux --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "e2e": "npm run build && node --test e2e/smoke.spec.mjs",
    "postinstall": "electron-rebuild -w better-sqlite3 || echo 'WARN: better-sqlite3 未能重建为 Electron ABI，npm run dev 前请执行 npx electron-rebuild -w better-sqlite3'"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-store": "^8.2.0",
    "iconv-lite": "^0.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
